# Réglage « production » du banc PLA-06 : celui de l'ancien serveur (deploy/vps/mysql.cnf), tel quel,
# sauf la mémoire tampon d'InnoDB, fixée par la série. Il est fait pour une seule base : la mesure
# dit ce qu'il donne avec 200 (60 connexions, 400 tables en cache).
[mysqld]
innodb_log_buffer_size = 8M
max_connections = 60
performance_schema = OFF
table_open_cache = 400
key_buffer_size = 8M
