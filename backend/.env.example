# ==================== BASE DE DONNÉES ====================
DB_NAME=hestim_planner
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_DIALECT=mysql

# ==================== SERVEUR ====================
PORT=5000
NODE_ENV=development
# Fuseau de l'école : « aujourd'hui », les heures de séance et les notifications en dépendent
TZ=Africa/Casablanca

# Origines autorisées pour CORS et la vérification CSRF (séparées par des virgules)
# En production : l'URL réelle du site (ex: https://planner.hestim.ma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Nombre de proxys devant l'API (nginx = 1). Sert à lire la vraie IP client pour le rate limiting.
TRUST_PROXY_HOPS=1

# Seed de démonstration automatique si la base est vide (développement uniquement,
# ignoré en production). Comptes créés avec un mot de passe connu : ne jamais activer en prod.
SEED_ON_EMPTY=false

# ==================== JWT / SESSIONS ====================
# OBLIGATOIRE — Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Ancien secret HS256 : ne sert plus qu'à défaut de CSRF_SECRET (jetons d'accès en RS256, plus bas)
JWT_SECRET=CHANGEZ_MOI_AVEC_UNE_VALEUR_ALEATOIRE_LONGUE
# Secret distinct pour signer les jetons CSRF (sinon JWT_SECRET est utilisé)
CSRF_SECRET=CHANGEZ_MOI_AUSSI
# strict : frontend et API servis sur la même origine (proxy Vite en dev, nginx en prod)
COOKIE_SAMESITE=strict
# Durées : jeton d'accès (secondes) et session de renouvellement (jours)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
# Conservation du journal de sécurité, en jours (365 par défaut, 30 au minimum)
JOURNAL_SECURITE_JOURS=365

# Quiz générés par l'IA (docs/plans/quiz-ia.md). Sans IA_CLE, la fonction est masquée.
# IA_FOURNISSEUR : openai-compatible (DeepSeek, Mistral, OpenAI, Groq…) ou anthropic
IA_FOURNISSEUR=openai-compatible
IA_URL=https://api.deepseek.com/v1
IA_CLE=
IA_MODELE=deepseek-chat
# Délai maximal d'une réponse (millisecondes) et générations par enseignant et par jour
IA_DELAI_MS=90000
IA_GENERATIONS_PAR_JOUR=20

# URL du frontend, utilisée dans les liens envoyés par email (réinitialisation de mot de passe)
FRONTEND_URL=http://localhost:5173

# ==================== EMAIL (Gmail App Password) ====================
EMAIL_SERVICE=smtp
EMAIL_FROM="HESTIM Planner <votre-email@gmail.com>"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
# Générer un mot de passe d'application Gmail : myaccount.google.com/apppasswords
SMTP_PASSWORD=VOTRE_MOT_DE_PASSE_APPLICATION_GMAIL

# ==================== CONNEXION UNIQUE (PHASE C) ====================
# Clé privée RSA des jetons d'accès (PEM sur une ligne, retours à la ligne écrits \n).
# Absente en développement : clé éphémère (les sessions tombent au redémarrage).
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out planner-jwt.pem
JWT_PRIVATE_KEY=
JWT_PREVIOUS_PUBLIC_KEY=
# Jeton de service de la synchronisation StudyLib (GET /api/integration/referentiel)
INTEGRATION_TOKEN=

# ==================== NOTIFICATIONS PUSH (PHASE D) ====================
# Notifications push de l'application mobile (Expo) : jeton d'accès Expo avec la « sécurité
# renforcée des push » activée dans le projet Expo (seul Planner peut alors envoyer)
EXPO_ACCESS_TOKEN=

# ==================== GÉNÉRATION (TIMEFOLD) ====================
# Service solver/ (java -jar solver/target/hestim-solver.jar) et jeton partagé, 32 caractères au moins
SOLVER_URL=http://localhost:8080
SOLVER_TOKEN=CHANGEZ_MOI_32_CARACTERES_MINIMUM_ALEATOIRES
