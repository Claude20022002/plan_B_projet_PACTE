# ─────────────────────────────────────────────────────────────────────────────
#  .env.docker — Variables d'environnement pour le déploiement Docker
#  Copier ce fichier en .env.docker et remplir les valeurs
#
#  ⚠️  NE JAMAIS committer .env.docker (contient des secrets)
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données ───────────────────────────────────────────────────────────
DB_NAME=hestim_planner
DB_USER=hestim
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PORT=3306

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=5000

# JWT — générer avec :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGEZ_MOI_AVEC_UNE_VALEUR_ALEATOIRE_DE_128_CHARS_MIN
JWT_EXPIRES_IN=7d

# CORS — URL(s) du frontend (séparées par des virgules si plusieurs)
ALLOWED_ORIGINS=http://localhost,https://mondomaine.com

# ── Service de génération (Timefold) ──────────────────────────────────────────
# Jeton partagé entre le backend et le solveur (32 caractères au moins) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOLVER_TOKEN=

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=80

# URL API utilisée par le frontend au moment du build Vite.
# Avec proxy Nginx dans docker-compose : laisser /api (recommandé)
# Avec frontend et backend sur des domaines distincts : https://api.mondomaine.com/api
VITE_API_URL=/api

# ── Email (Gmail App Password) ────────────────────────────────────────────────
EMAIL_FROM="HESTIM Planner <noreply@mondomaine.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=VOTRE_MOT_DE_PASSE_APPLICATION_GMAIL
