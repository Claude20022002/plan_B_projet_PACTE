# ─────────────────────────────────────────────────────────────────────────────
#  .env.docker — Variables d'environnement pour le déploiement Docker
#  Copier ce fichier en .env.docker et remplir les valeurs
#
#  ⚠️  NE JAMAIS committer .env.docker (contient des secrets)
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données ───────────────────────────────────────────────────────────
DB_NAME=hestim_planner
DB_USER=hestim
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PORT=3306

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=5000

# Jetons d'accès RS256 (Planner est le fournisseur d'identité ; StudyLib et l'application
# mobile vérifient avec la clé publique publiée sur /api/.well-known/jwks.json).
# Générer la clé privée, puis la mettre sur une seule ligne (retours à la ligne écrits \n) :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out planner-jwt.pem
#   awk 'NF {printf "%s\\n", $0}' planner-jwt.pem
JWT_PRIVATE_KEY=
# Rotation : ancienne clé publique, gardée publiée le temps que ses jetons expirent (15 min)
JWT_PREVIOUS_PUBLIC_KEY=
# Secret des jetons CSRF :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
CSRF_SECRET=

# Synchronisation des filières et modules vers StudyLib (lecture seule, 32 caractères au moins)
INTEGRATION_TOKEN=

# CORS — URL(s) du frontend (séparées par des virgules si plusieurs)
ALLOWED_ORIGINS=http://localhost,https://mondomaine.com

# ── Service de génération (Timefold) ──────────────────────────────────────────
# Jeton partagé entre le backend et le solveur (32 caractères au moins) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOLVER_TOKEN=

# Notifications push de l'application mobile (Expo) : jeton d'accès Expo avec la « sécurité
# renforcée des push » activée dans le projet Expo (seul Planner peut alors envoyer)
EXPO_ACCESS_TOKEN=

# ── Passerelle et bibliothèque StudyLib (phase C) ─────────────────────────────
# Domaines publics (Caddy obtient les certificats) ; en local : localhost et fichiers.localhost
SITE_ADDRESS=
FICHIERS_ADDRESS=
# StudyLib (../StudyLib) : clé Laravel (php artisan key:generate --show) et mot de passe de sa base
STUDYLIB_APP_KEY=
STUDYLIB_DB_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MEILI_MASTER_KEY=
# Dossier de l'hôte contenant google-drive.json (clé du compte de service Drive, hors Git),
# monté en lecture seule dans StudyLib ; par défaut ../StudyLib/storage/app/private
GOOGLE_DRIVE_KEY_DIR=
# Dossier Drive importé par défaut (fin de l'URL drive.google.com/drive/folders/<ID>,
# pas le client_id numérique du compte de service)
GOOGLE_DRIVE_FOLDER_ID=

# ── Jeux pédagogiques ClassQuiz (phase Q, fork ../ClassQuiz) ──────────────────
# Sous-domaine public (Caddy) ; en local : quiz.localhost
QUIZ_ADDRESS=
# Secrets à générer (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ;
# hexadécimaux : ils entrent dans des URL (REDIS_PASSWORD aussi, pour la même raison)
QUIZ_SECRET_KEY=
QUIZ_DB_PASSWORD=
# Client OpenID Connect « classquiz » déclaré par Planner (32 caractères au moins)
CLASSQUIZ_OIDC_CLIENT_SECRET=
# Clés de signature des cookies du fournisseur OpenID Connect, séparées par des virgules
# (la première signe, les suivantes vérifient encore pendant une rotation)
OIDC_COOKIE_KEYS=

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=80

# URL API utilisée par le frontend au moment du build Vite.
# Avec proxy Nginx dans docker-compose : laisser /api (recommandé)
# Avec frontend et backend sur des domaines distincts : https://api.mondomaine.com/api
VITE_API_URL=/api

# ── Email (Gmail App Password) ────────────────────────────────────────────────
EMAIL_FROM="HESTIM Planner <noreply@mondomaine.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=VOTRE_MOT_DE_PASSE_APPLICATION_GMAIL
