# Aiguillage interne sur un VPS partagé : le HTTPS est fait par le nginx déjà en place
# (voir nginx-hestim.conf), qui renvoie les trois sous-domaines ici en HTTP.
# Il est le seul à joindre ce port (172.17.0.1:8090) : on lui fait confiance pour
# X-Forwarded-For et X-Forwarded-Proto (https).
{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

http://{$SITE_ADDRESS} {
	encode zstd gzip
	header -Server
	# Écran du projecteur dans Planner (lot CQ-1) : le WebSocket du moteur de quiz, sur la même
	# origine que le site. Planner n'utilise pas /socket.io lui-même. Les cookies de session de
	# Planner (chemin « / ») ne sont pas transmis au moteur : il n'en a pas besoin.
	handle /socket.io/* {
		reverse_proxy quiz-api:80 {
			header_up -Cookie
		}
	}
	handle {
		reverse_proxy frontend:80
	}
}

# Téléchargements : liens signés pour l'hôte interne minio:9000 ; lecture seule.
http://{$FICHIERS_ADDRESS} {
	@lecture method GET HEAD
	handle @lecture {
		reverse_proxy minio:9000 {
			header_up Host minio:9000
		}
	}
	handle {
		respond "Méthode non autorisée" 405
	}
}

# Jeux pédagogiques (ClassQuiz)
http://{$QUIZ_ADDRESS} {
	encode zstd gzip
	# En-têtes de sécurité (audit du 15 octobre) : le site du quiz n'en renvoyait aucun. Aucune page
	# de Planner ne l'affiche dans un cadre (l'application l'ouvre dans une vue navigateur) : les
	# cadres sont refusés. Pas de CSP complète : le site SvelteKit charge des scripts en ligne.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	handle /api/* {
		reverse_proxy quiz-api:80
	}
	handle /socket.io/* {
		reverse_proxy quiz-api:80
	}
	handle {
		reverse_proxy quiz-frontend:3000
	}
}
