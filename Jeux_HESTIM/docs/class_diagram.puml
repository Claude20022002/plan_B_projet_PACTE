@startuml
class Utilisateur {
  +int id
  +string nom
  +string email
  +string role
  +string statut
}

class Classe {
  +int id
  +string nom
}

class Matiere {
  +int id
  +string nom
}

class Session {
  +int id
  +string statut
  +date dateDebut
}

class Groupe {
  +int id
  +string nom
  +int score
}

class SousGroupe {
  +int id
  +string nom
  +int score
  +json etatProgression
}

Utilisateur "0..*" -- "1" Classe : appartient
Classe "1" -- "0..*" Matiere : contient
Matiere "1" -- "0..*" Session : active
Session "1" -- "1" Classe : concerne
Classe "1" -- "0..*" Groupe : divise
Groupe "1" -- "0..*" SousGroupe : contient
SousGroupe "1" -- "0..*" Utilisateur : regroupe
@enduml
