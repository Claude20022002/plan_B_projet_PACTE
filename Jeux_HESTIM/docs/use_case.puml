actor "Enseignant" as Prof
actor "Participant" as Etudiant

rectangle "Plateforme Jeux Pédagogiques" {
  usecase "Gestion Classes & Matières" as UC1
  usecase "Gestion Jeux" as UC2
  usecase "Validation Comptes" as UC3
  usecase "Planification Sessions" as UC4
  usecase "Gestion Groupes" as UC5
  usecase "Lancement/Finalisation Jeu" as UC6
  usecase "Inscription" as UC7
  usecase "Récupération MDP" as UC8
