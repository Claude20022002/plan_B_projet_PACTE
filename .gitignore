*.log
node_modules

# Secrets et configuration locale (les modèles *.example restent versionnés)
.env
.env.*
!.env.example
!.env.*.example

# Identifiants générés par les tests Playwright et rapports de test
frontend/auth/
playwright-report/
test-results/
coverage/
.playwright-mcp/
.impeccable/review/
.impeccable/questions/
.impeccable/mocks/
.impeccable/build/

# Cookies exportés par curl lors de tests manuels
csrf_token=*
*.cookies

# Fichiers système
.DS_Store
Thumbs.db
# Fichiers de verrouillage d'Office (document ouvert dans Word, PowerPoint ou Excel)
~$*
# Tableurs : une liste d'étudiants ou d'enseignants ne se versionne pas (données personnelles).
# Seuls les modèles d'import, remplis de personnes fictives, restent dans le dépôt.
*.xlsx
*.xls
!docs/modeles/*.xlsx
google-drive.json
StudyLib-*.json
# Paquets de mise à jour du serveur (deploy/vps/preparer-maj.sh)
deploy/vps/paquets/

# Python
__pycache__/
*.pyc
